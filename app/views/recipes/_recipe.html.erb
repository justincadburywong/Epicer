<%= link_to recipe_path(recipe), data: { turbo_frame: "_top" }, class: "block bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-shadow overflow-hidden group" do %>
  <% if recipe.display_image.present? %>
    <div class="w-full" style="height: 0; padding-bottom: 100%; position: relative;">
      <%= image_tag recipe.display_image,
                   style: "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;",
                   alt: recipe.title,
                   loading: "lazy",
                   decoding: "async",
                   fetchpriority: "auto",
                   sizes: "(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw",
                   class: "group-hover:scale-105 transition-transform duration-300" %>
    </div>
  <% else %>
    <!-- Debug: No display image found -->
    <div class="w-full" style="height: 0; padding-bottom: 100%; position: relative;">
      <div class="bg-gray-100 dark:bg-gray-700 flex items-center justify-center text-gray-500 dark:text-gray-400 text-sm absolute inset-0">
        No Image
      </div>
    </div>
  <% end %>
  <div class="p-4">
    <h2 class="font-semibold text-lg text-gray-900 dark:text-gray-100 mb-2"><%= recipe.title %></h2>
    
    <% if recipe.rating.present? %>
      <div class="mb-2">
        <% recipe.rating.times do %><span class="text-yellow-400 dark:text-yellow-500 text-sm">★</span><% end %>
        <% (5 - recipe.rating).times do %><span class="text-gray-300 dark:text-gray-600 text-sm">★</span><% end %>
      </div>
    <% end %>

    <% if recipe.description.present? %>
      <p class="text-gray-600 dark:text-gray-400 text-sm mb-3 line-clamp-2"><%= recipe.description %></p>
    <% end %>

    <div class="flex gap-3 text-xs text-gray-500 dark:text-gray-400">
      <% if recipe.total_time.positive? %>
        <span><%= recipe.total_time %> min</span>
      <% end %>
      <% if recipe.servings.present? %>
        <span><%= recipe.servings %> servings</span>
      <% end %>
      <% if recipe.ingredients.any? %>
        <span><%= recipe.ingredients.count %> ingredients</span>
      <% end %>
    </div>

    <% if recipe.tags.any? %>
      <div class="mt-3 flex flex-wrap gap-1">
        <% recipe.tags.limit(3).each do |tag| %>
          <span class="text-xs bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full"><%= tag.name %></span>
        <% end %>
        <% if recipe.tags.count > 3 %>
          <span class="text-xs text-gray-400">+<%= recipe.tags.count - 3 %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
